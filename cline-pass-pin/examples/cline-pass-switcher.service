# systemd 模板。一键脚本 --install-service 会按本机 HOME / PORT / node 路径生成。
# 不要把 sk_ 写进这个文件。Key 只活在 ~/.cline-pass-switcher/config.json。
#
# 手装：
#   sudo cp examples/cline-pass-switcher.service /etc/systemd/system/
#   # 按需改 User / WorkingDirectory / Environment / ExecStart
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cline-pass-switcher
#
# 卸载：
#   sudo systemctl disable --now cline-pass-switcher
#   sudo rm /etc/systemd/system/cline-pass-switcher.service

[Unit]
Description=cline-pass-switcher (pin DeepSeek V4.1 Flash to Vercel deepseek)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.cline-pass-switcher
Environment=DATA_DIR=/root/.cline-pass-switcher
Environment=PORT=3123
Environment=BIND_HOST=127.0.0.1
ExecStart=/usr/bin/node /root/.cline-pass-switcher/src/server.js
Restart=always
RestartSec=2
StandardOutput=append:/root/.cline-pass-switcher/switcher.log
StandardError=append:/root/.cline-pass-switcher/switcher.log

[Install]
WantedBy=multi-user.target
